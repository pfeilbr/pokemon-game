# ---------------------------------------------------------------------------
# Mathmon Battle League - environment
#
# EVERY variable here is optional. With none of them set the game still runs,
# in "Local Play" mode: no accounts, progress saved in the browser.
# ---------------------------------------------------------------------------

# Signs the session cookie. Set this to enable accounts in production.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Any Postgres connection string (Neon, Supabase, Vercel Postgres, local).
# When set, the game turns on accounts + cross-device progress sync.
# Vercel's Neon integration injects this for you automatically.
DATABASE_URL=

# Optional Google sign-in. Create an OAuth 2.0 Client ID (type: Web) at
# https://console.cloud.google.com/apis/credentials and add
#   https://<your-domain>/api/auth/google/callback
# as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
